// Uni Mart data model.
//
// Identity is unified: a "vendor" is a User (role VENDOR) with an attached
// Vendor business profile. Listings, orders and conversations always point
// at a User for the seller side — join the Vendor relation to know whether
// that seller is a verified campus business.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  VENDOR
  ADMIN
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum HandoverMethod {
  LOCKER
  MEET
  DELIVER
}

enum ListingStatus {
  LIVE
  DRAFT
  SOLD
}

enum OrderStatus {
  PAID
  DROPPED
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum LedgerType {
  CREDIT
  DEBIT
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  fullName        String
  campus          String
  course          String    @default("")
  year            Int       @default(1)
  role            UserRole  @default(STUDENT)
  interests       String[]  @default([])
  walletBalance   Int       @default(0)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vendor                Vendor?
  sessions              Session[]
  otpCodes              OtpCode[]
  listings              Listing[]           @relation("ListingSeller")
  savedListings         SavedListing[]
  cartItems             CartItem[]
  ordersBuying          Order[]             @relation("OrderBuyer")
  ordersSelling         Order[]             @relation("OrderSeller")
  conversationsAsBuyer  Conversation[]      @relation("ConversationBuyer")
  conversationsAsSeller Conversation[]      @relation("ConversationSeller")
  messages              Message[]
  notifications         Notification[]
  ledgerEntries         WalletLedgerEntry[]
  reviewsWritten        Review[]            @relation("ReviewAuthor")
  reviewsReceived       Review[]            @relation("ReviewTarget")

  @@index([role])
}

model Vendor {
  id           String       @id @default(cuid())
  ownerId      String       @unique
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  businessName String
  category     String
  description  String
  campus       String
  status       VendorStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  approvedAt   DateTime?

  @@index([status])
}

model Session {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model OtpCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  icon     String
  listings Listing[]
}

model Listing {
  id             String           @id @default(cuid())
  title          String
  price          Int
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  department     String
  condition      Condition
  description    String
  photoCount     Int              @default(1)
  distanceMeters Int              @default(0)
  location       String
  status         ListingStatus    @default(LIVE)
  views          Int              @default(0)
  handover       HandoverMethod[]
  sellerId       String
  seller         User             @relation("ListingSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  savedBy       SavedListing[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  conversations Conversation[]

  @@index([categoryId])
  @@index([sellerId])
  @@index([status])
}

model SavedListing {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  qty       Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model Order {
  id             String         @id @default(cuid())
  orderNumber    String         @unique
  buyerId        String
  buyer          User           @relation("OrderBuyer", fields: [buyerId], references: [id])
  sellerId       String
  seller         User           @relation("OrderSeller", fields: [sellerId], references: [id])
  subtotal       Int
  handoverCost   Int
  discount       Int            @default(0)
  total          Int
  handoverMethod HandoverMethod
  status         OrderStatus    @default(PAID)
  pickupCode     String
  reviewed       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  droppedAt      DateTime?
  collectedAt    DateTime?

  items  OrderItem[]
  review Review?

  @@index([buyerId])
  @@index([sellerId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  title     String
  price     Int
  qty       Int
}

model Conversation {
  id               String    @id @default(cuid())
  listingId        String
  listing          Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId          String
  buyer            User      @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId         String
  seller           User      @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyerLastReadAt  DateTime?
  sellerLastReadAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  messages Message[]

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text           String?
  offerAmount    Int?
  offerStatus    OfferStatus?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model WalletLedgerEntry {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  amount    Int
  type      LedgerType
  createdAt DateTime   @default(now())

  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  targetId  String
  target    User     @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)
  rating    Int
  tags      String[] @default([])
  note      String?
  createdAt DateTime @default(now())

  @@index([targetId])
}
